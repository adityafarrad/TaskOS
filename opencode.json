{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "*": "ask",

      "swift test": "allow",
      "swift test *": "allow",
      "xcodebuild": "allow",
      "xcodebuild *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "echo": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git add": "allow",
      "git add *": "allow",
      "git commit": "allow",
      "git commit *": "allow",

      "git push": "ask",
      "git push *": "ask",
      "git merge": "ask",
      "git merge *": "ask",
      "git rebase": "ask",
      "git rebase *": "ask",
      "git push --force": "ask",
      "git push --force*": "ask",
      "git push --force-with-lease": "ask",
      "git push --force-with-lease*": "ask",
      "git reset --hard": "ask",
      "git reset --hard *": "ask",
      "git clean": "ask",
      "git clean *": "ask",
      "rm": "ask",
      "rm *": "ask",
      "sudo": "ask",
      "sudo *": "ask"
    }
  }
}
